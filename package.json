{
  "name": "etanzeem_diary_app",
  "main": "expo-router/entry",
  "version": "1.0.7",
  "scripts": {
    "start": "cross-env CI=false expo start",
    "predev:android": "adb reverse tcp:8081 tcp:8081 || true",
    "dev:android": "cross-env CI=false REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo start --localhost",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env CI=false expo run:android",
    "ios": "cross-env CI=false expo run:ios",
    "web": "cross-env CI=false expo start --web",
    "test": "jest --watchAll",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "lint": "expo lint",
    "android:build": "cd android && ./gradlew assembleRelease && cd ..",
    "postinstall": "node -e \"try { require('child_process').execSync('cd ios && pod install', { stdio: 'inherit' }); } catch (e) { console.log('Skipping pod install: ' + e.message); }\""
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
