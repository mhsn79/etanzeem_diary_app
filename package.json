{
  "name": "etanzeem_diary_app",
  "main": "expo-router/entry",
  "version": "1.0.3",
  "scripts": {
    "start": "cross-env CI=false expo start",
    "predev:android": "adb reverse tcp:8081 tcp:8081 || true",
    "dev:android": "cross-env CI=false REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo start --localhost",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env CI=false expo run:android",
    "ios": "cross-env CI=false expo run:ios",
    "web": "cross-env CI=false expo start --web",
    "test": "jest --watchAll",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "lint": "expo lint",
    "android:build": "cd android && ./gradlew assembleRelease && cd ..",
    "postinstall": "node -e \"try { require('child_process').execSync('cd ios && pod install', { stdio: 'inherit' }); } catch (e) { console.log('Skipping pod install: ' + e.message); }\""
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@directus/sdk": "^19.1.0",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@reduxjs/toolkit": "^1.9.3",
    "dayjs": "^1.11.7",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.3",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.20",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "i18n-js": "^4.5.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-mmkv": "^2.1.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "react-native-vector-icons": "^10.2.0",
    "react-redux": "^8.0.5",
    "redux-persist": "^6.0.0",
    "react-native-web": "~0.19.13",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.6",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
