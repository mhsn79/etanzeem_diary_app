{
  "cli": {
    "version": ">= 7.8.3"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "qa": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "qa"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
